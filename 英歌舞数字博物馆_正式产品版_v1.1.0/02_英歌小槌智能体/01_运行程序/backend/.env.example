# Copy this file to .env only when you need environment fallbacks. Never commit the real .env.
# The local management workbench can save an encrypted DeepSeek key outside web/;
# DEEPSEEK_API_KEY remains an optional server-side fallback and is never returned to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=true
DEEPSEEK_MAX_TOKENS=4096
AGENT_PORT=8787
AGENT_HOST=127.0.0.1
NODE_ENV=development
AGENT_MODEL_TIMEOUT_MS=45000
AGENT_MAX_BODY_BYTES=131072
AGENT_RATE_LIMIT_PER_MINUTE=30
# List exact trusted origins, separated by commas. Wildcards are not accepted.
AGENT_ALLOWED_ORIGINS=http://127.0.0.1:8096,http://localhost:8096,http://127.0.0.1:8080,http://localhost:8080
# Production requires true and uses a __Host- prefixed HttpOnly cookie.
AGENT_COOKIE_SECURE=false
# Optional legacy/multi-role credentials. When blank, first local access creates an owner account
# with username/password and an HttpOnly cookie. For separated review/publish duties, configure
# non-browser role credentials whose values are {"id":"operator-id","role":"author|reviewer|publisher"}.
ADMIN_CREDENTIALS_JSON=
# Optional private state directory for password hashes and encrypted model settings.
# Keep it outside web/, Git and model-input folders. The default is the OS local application-data area.
ADMIN_PRIVATE_STATE_DIR=
# Production-only persistent path contract. Every private path below must be absolute,
# outside the release/web roots, and contained by YINGGE_PRIVATE_STATE_ROOT.
YINGGE_PRIVATE_STATE_ROOT=
AGENT_STORE_DIR=
CURATION_CATALOG_PATH=
CURATION_AUDIT_PATH=
SITE_CONTENT_PATH=
SITE_CONTENT_AUDIT_PATH=
ADMIN_PLANS_PATH=
ADMIN_APPS_PATH=
AGENT_OPERATIONS_STATE_DIR=
KNOWLEDGE_GOVERNANCE_DIR=
KNOWLEDGE_SOURCE_DIR=
KNOWLEDGE_BUILD_OUTPUT_DIR=
# Server-only retrieval data. Never point this at web/ in production.
KNOWLEDGE_RUNTIME_DATA_DIR=
KNOWLEDGE_GRAPH_PATH=
YINGGE_BACKUP_DIR=
# This is the only generated curation projection intended for the public static tree.
CURATION_PUBLIC_PATH=
# Optional admin-only candidate preview. Use a read-only directory outside web/, Git and model inputs.
# When blank or unavailable, the preview API fails closed and the admin UI reports that the private library is disconnected.
CURATION_PRIVATE_MEDIA_ROOT=
CURATION_PRIVATE_MEDIA_MAX_BYTES=12582912

# Tencent Cloud ASR/TTS credentials stay server-side. Never place them in web files.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_APP_ID=
TENCENT_REGION=ap-guangzhou
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
# Choose one: an existing vocabulary ID, or an explicit temporary list. The list wins.
# If both are blank, the server sends its reviewed Yingge domain list on every ASR request.
TENCENT_ASR_HOTWORD_ID=
TENCENT_ASR_HOTWORD_LIST=
TENCENT_TTS_VOICE_TYPE=603000
TENCENT_TTS_SAMPLE_RATE=24000
