[Unit]
Description=Yingge Museum knowledge and voice API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yingge
Group=yingge
WorkingDirectory=/srv/yingge-museum/current/runtime
EnvironmentFile=/etc/yingge-museum/yingge-museum.env
ExecStartPre=/usr/bin/node backend/production-preflight.mjs
ExecStart=/usr/bin/node backend/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStartSec=75
TimeoutStopSec=20
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/yingge-museum

[Install]
WantedBy=multi-user.target
