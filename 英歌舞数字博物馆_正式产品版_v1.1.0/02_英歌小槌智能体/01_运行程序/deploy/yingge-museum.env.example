# Copy to /etc/yingge-museum/yingge-museum.env and fill real secret values
# there. Keep permissions at 0640 root:yingge. Do not put this completed file
# inside a release or Git working tree.
NODE_ENV=production
AGENT_HOST=127.0.0.1
AGENT_PORT=8787
AGENT_ALLOWED_ORIGINS=https://yinggemus.cn,https://www.yinggemus.cn,https://5.mgd5.com
AGENT_COOKIE_SECURE=true
AGENT_MODEL_TIMEOUT_MS=45000
AGENT_MAX_BODY_BYTES=131072
AGENT_RATE_LIMIT_PER_MINUTE=30

# Every path here is absolute. The runtime never guesses the public site from
# private-state paths: this must match Nginx's `root` for the active release.
YINGGE_PUBLIC_WEB_ROOT=/srv/yingge-museum/current/web
# Private data stays under the first root; the one public curation projection
# is intentionally outside it.
YINGGE_PRIVATE_STATE_ROOT=/var/lib/yingge-museum/private
AGENT_STORE_DIR=/var/lib/yingge-museum/private/store
ADMIN_PRIVATE_STATE_DIR=/var/lib/yingge-museum/private/admin
CURATION_CATALOG_PATH=/var/lib/yingge-museum/private/curation/exhibits.json
CURATION_AUDIT_PATH=/var/lib/yingge-museum/private/curation/audit.jsonl
CURATION_PUBLIC_PATH=/var/lib/yingge-museum/public/data/exhibits.public.json
SITE_CONTENT_PATH=/var/lib/yingge-museum/private/content/site-content.json
SITE_CONTENT_AUDIT_PATH=/var/lib/yingge-museum/private/content/site-content-audit.jsonl
ADMIN_PLANS_PATH=/var/lib/yingge-museum/private/admin/plans.json
ADMIN_APPS_PATH=/var/lib/yingge-museum/private/admin/apps.json
AGENT_OPERATIONS_STATE_DIR=/var/lib/yingge-museum/private/agent/generated
KNOWLEDGE_GOVERNANCE_DIR=/var/lib/yingge-museum/private/knowledge/governance
KNOWLEDGE_SOURCE_DIR=/var/lib/yingge-museum/private/knowledge/content
KNOWLEDGE_BUILD_OUTPUT_DIR=/var/lib/yingge-museum/private/knowledge/build
KNOWLEDGE_RUNTIME_DATA_DIR=/var/lib/yingge-museum/private/knowledge/runtime
KNOWLEDGE_GRAPH_PATH=/var/lib/yingge-museum/private/knowledge/knowledge_graph.json
YINGGE_BACKUP_DIR=/var/lib/yingge-museum/backups
CURATION_PRIVATE_MEDIA_ROOT=/var/lib/yingge-museum/private-media
CURATION_PRIVATE_MEDIA_MAX_BYTES=12582912

# Configure separated reviewer and publisher credentials as JSON. Do not use a
# sample that looks like a real token; production preflight requires >=32 chars.
ADMIN_CREDENTIALS_JSON=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=false
DEEPSEEK_MAX_TOKENS=4096

# Tencent Cloud credentials are server-only. Either use a reviewed hotword ID
# or leave both hotword fields blank to use the reviewed temporary domain list.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_APP_ID=
TENCENT_REGION=ap-guangzhou
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
TENCENT_ASR_HOTWORD_ID=
TENCENT_ASR_HOTWORD_LIST=
TENCENT_TTS_VOICE_TYPE=603000
TENCENT_TTS_SAMPLE_RATE=24000
