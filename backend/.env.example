# Copy this file to .env and fill the key. Never commit the real .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=true
DEEPSEEK_MAX_TOKENS=4096
AGENT_PORT=8787
AGENT_MODEL_TIMEOUT_MS=45000
AGENT_MAX_BODY_BYTES=131072
AGENT_RATE_LIMIT_PER_MINUTE=30
# Production should list exact origins, separated by commas. Use * only for local development.
AGENT_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Optional for server deployment. Leave blank for local-only mode.
ADMIN_TOKEN=
